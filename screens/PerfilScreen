import { View, Text, ScrollView, TouchableOpacity, StyleSheet } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { theme } from '../lib/theme';

const BANCOS_PY = [
  { id: 1, nombre: 'Itaú', color: '#EC7000' },
  { id: 2, nombre: 'Sudameris', color: '#003087' },
  { id: 3, nombre: 'GNB', color: '#0066CC' },
  { id: 4, nombre: 'Ueno', color: '#7C3AED' },
  { id: 5, nombre: 'Atlas', color: '#D32F2F' },
  { id: 6, nombre: 'Familiar', color: '#0057A8' },
  { id: 7, nombre: 'Continental', color: '#006633' },
  { id: 8, nombre: 'BASA', color: '#B8860B' },
  { id: 9, nombre: 'Solar', color: '#FF6600' },
  { id: 10, nombre: 'BNF', color: '#003399' },
  { id: 11, nombre: 'FIC', color: '#8B0000' },
  { id: 12, nombre: 'Interfisa', color: '#006666' },
];

export default function PerfilScreen() {
  const [bancosSeleccionados, setBancosSeleccionados] = React.useState([]);

  const toggleBanco = (id) => {
    setBancosSeleccionados(prev =>
      prev.includes(id) ? prev.filter(b => b !== id) : [...prev, id]
    );
  };

  const MenuItem = ({ icon, label, value, color, onPress }) => (
    <TouchableOpacity style={s.menuItem} onPress={onPress}>
      <View style={[s.menuIcon, { backgroundColor: (color || theme.colors.primary) + '22' }]}>
        <Ionicons name={icon} size={18} color={color || theme.colors.primary} />
      </View>
      <Text style={s.menuLabel}>{label}</Text>
      {value ? <Text style={s.menuValue}>{value}</Text> : null}
      <Ionicons name="chevron-forward" size={16} color={theme.colors.textMuted} />
    </TouchableOpacity>
  );

  return (
    <ScrollView style={s.container} showsVerticalScrollIndicator={false}>
      {/* HEADER */}
      <View style={s.header}>
        <View style={s.avatar}>
          <Ionicons name="person" size={32} color={theme.colors.primary} />
        </View>
        <Text style={s.nombre}>Mi Ahorrapp</Text>
        <Text style={s.sub}>Seleccioná tus bancos para ver beneficios personalizados</Text>
      </View>

      {/* MIS BANCOS */}
      <View style={s.section}>
        <Text style={s.sectionTitle}>🏦 Mis bancos</Text>
        <Text style={s.sectionSub}>Seleccioná los bancos donde tenés tarjeta</Text>
        <View style={s.bancosGrid}>
          {BANCOS_PY.map(b => {
            const sel = bancosSeleccionados.includes(b.id);
            return (
              <TouchableOpacity
                key={b.id}
                style={[s.bancoChip, sel && { backgroundColor: b.color + '22', borderColor: b.color }]}
                onPress={() => toggleBanco(b.id)}
              >
                <View style={[s.bancoDot, { backgroundColor: b.color }]} />
                <Text style={[s.bancoNombre, sel && { color: theme.colors.text, fontWeight: '700' }]}>{b.nombre}</Text>
                {sel && <Ionicons name="checkmark-circle" size={14} color={b.color} />}
              </TouchableOpacity>
            );
          })}
        </View>
        {bancosSeleccionados.length > 0 && (
          <View style={s.selBox}>
            <Text style={s.selText}>✓ {bancosSeleccionados.length} banco{bancosSeleccionados.length > 1 ? 's' : ''} seleccionado{bancosSeleccionados.length > 1 ? 's' : ''}</Text>
          </View>
        )}
      </View>

      {/* INFO */}
      <View style={s.section}>
        <Text style={s.sectionTitle}>ℹ️ Sobre Ahorrapp</Text>
        <View style={s.card}>
          <MenuItem icon="information-circle-outline" label="¿Cómo funciona?" />
          <View style={s.divider} />
          <MenuItem icon="shield-checkmark-outline" label="Privacidad" color={theme.colors.success} />
          <View style={s.divider} />
          <MenuItem icon="star-outline" label="Versión" value="1.0.0" color={theme.colors.warning} />
          <View style={s.divider} />
          <MenuItem icon="chatbubble-outline" label="Sugerencias" color={theme.colors.accent} />
        </View>
      </View>

      {/* STATS */}
      <View style={s.section}>
        <Text style={s.sectionTitle}>📊 En Ahorrapp</Text>
        <View style={s.statsGrid}>
          {[
            { label: 'Bancos', value: '16', icon: 'business', color: theme.colors.primary },
            { label: 'Beneficios', value: '80+', icon: 'pricetag', color: theme.colors.warning },
            { label: 'Categorías', value: '28', icon: 'apps', color: theme.colors.accent },
          ].map(st => (
            <View key={st.label} style={s.statCard}>
              <Ionicons name={st.icon} size={22} color={st.color} />
              <Text style={[s.statNum, { color: st.color }]}>{st.value}</Text>
              <Text style={s.statLabel}>{st.label}</Text>
            </View>
          ))}
        </View>
      </View>

      <View style={{ height: 40 }} />
    </ScrollView>
  );
}

