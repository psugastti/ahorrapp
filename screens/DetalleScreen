import { View, Text, ScrollView, TouchableOpacity, StyleSheet, Linking } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { theme } from '../lib/theme';

const DIAS_LABEL = { lunes:'Lunes', martes:'Martes', miercoles:'Miércoles', jueves:'Jueves', viernes:'Viernes', sabado:'Sábado', domingo:'Domingo' };

export default function DetalleScreen({ route, navigation }) {
  const { beneficio: b } = route.params;
  const hoy = new Date().toISOString().slice(0, 10);
  const vencido = b.vence && b.vence < hoy;
  const tipo = b.tipo_tarjeta_simple || b.tipo_tarjeta || 'ambas';

  const tipoLabel = { credito: '💳 Solo Crédito', debito: '🏦 Solo Débito', premium: '⭐ Solo Premium', ambas: '💳 Crédito y Débito' };

  const InfoRow = ({ icon, label, value, color }) => (
    <View style={s.infoRow}>
      <View style={s.infoIcon}><Ionicons name={icon} size={16} color={color || theme.colors.primary} /></View>
      <View style={{ flex: 1 }}>
        <Text style={s.infoLabel}>{label}</Text>
        <Text style={s.infoValue}>{value}</Text>
      </View>
    </View>
  );

  return (
    <View style={s.container}>
      {/* HEADER con color del banco */}
      <View style={[s.header, { backgroundColor: b.bancos?.color || theme.colors.primary }]}>
        <TouchableOpacity style={s.backBtn} onPress={() => navigation.goBack()}>
          <Ionicons name="arrow-back" size={22} color="#fff" />
        </TouchableOpacity>
        <View style={s.headerBody}>
          <Text style={s.headerBanco}>{b.bancos?.nombre}</Text>
          <Text style={s.headerComercio}>{b.comercio}</Text>
          {b.porcentaje ? (
            <View style={s.pctBig}>
              <Text style={s.pctBigText}>{b.porcentaje}%</Text>
              <Text style={s.pctBigSub}>{b.etiqueta || 'de beneficio'}</Text>
            </View>
          ) : b.etiqueta ? (
            <View style={s.pctBig}>
              <Text style={s.pctBigSub}>{b.etiqueta}</Text>
            </View>
          ) : null}
        </View>
      </View>

      <ScrollView style={s.body} showsVerticalScrollIndicator={false}>
        {/* ESTADO */}
        <View style={[s.estadoBadge, vencido ? s.estadoRojo : s.estadoVerde]}>
          <Ionicons name={vencido ? 'warning' : 'checkmark-circle'} size={14} color={vencido ? theme.colors.danger : theme.colors.success} />
          <Text style={[s.estadoText, { color: vencido ? theme.colors.danger : theme.colors.success }]}>
            {vencido ? 'Beneficio vencido' : 'Beneficio activo'}
          </Text>
        </View>

        {/* DESCRIPCIÓN */}
        {b.descripcion ? (
          <View style={s.card}>
            <Text style={s.cardTitle}>Descripción</Text>
            <Text style={s.cardText}>{b.descripcion}</Text>
          </View>
        ) : null}

        {/* DETALLES */}
        <View style={s.card}>
          <Text style={s.cardTitle}>Detalles del beneficio</Text>

          <InfoRow icon="calendar-outline" label="Días válidos"
            value={b.todos_los_dias ? 'Todos los días' : b.dias?.length > 0 ? b.dias.map(d => DIAS_LABEL[d] || d).join(', ') : 'No especificado'} />

          <View style={s.divider} />
          <InfoRow icon="card-outline" label="Tarjeta" value={tipoLabel[tipo] || 'Crédito y Débito'} />

          {b.tope_monto > 0 && (
            <>
              <View style={s.divider} />
              <InfoRow icon="arrow-up-circle-outline" label="Tope máximo" value={`Gs. ${b.tope_monto.toLocaleString()}`} color={theme.colors.warning} />
            </>
          )}
          {b.compra_minima > 0 && (
            <>
              <View style={s.divider} />
              <InfoRow icon="arrow-down-circle-outline" label="Compra mínima" value={`Gs. ${b.compra_minima.toLocaleString()}`} />
            </>
          )}
          {b.vence && (
            <>
              <View style={s.divider} />
              <InfoRow icon="time-outline" label="Vencimiento" value={b.vence} color={vencido ? theme.colors.danger : theme.colors.primary} />
            </>
          )}
          {b.requiere_qr && (
            <>
              <View style={s.divider} />
              <InfoRow icon="qr-code-outline" label="Método de pago" value="Requiere pago con QR" color={theme.colors.warning} />
            </>
          )}
          <View style={s.divider} />
          <InfoRow icon="pricetag-outline" label="Categoría" value={`${b.categorias?.emoji || ''} ${b.categorias?.nombre || '—'}`} />
        </View>

        {/* BOTÓN BASES */}
        {b.url_bases ? (
          <TouchableOpacity style={s.btnBases} onPress={() => Linking.openURL(b.url_bases)}>
            <Ionicons name="document-text-outline" size={18} color={theme.colors.primary} />
            <Text style={s.btnBasesText}>Ver bases y condiciones</Text>
            <Ionicons name="open-outline" size={16} color={theme.colors.primary} />
          </TouchableOpacity>
        ) : null}

        {b.featured && (
          <View style={s.featuredBadge}>
            <Ionicons name="star" size={14} color="#F59E0B" />
            <Text style={s.featuredText}>Beneficio destacado</Text>
          </View>
        )}

        <View style={{ height: 40 }} />
      </ScrollView>
    </View>
  );
}

const s = StyleSheet.create({
  container: { flex: 1, backgroundColor: theme.colors.bg },
  header: { paddingTop: 56, paddingBottom: 28, paddingHorizontal: 20 },
  backBtn: { width: 36, height: 36, borderRadius: 18, backgroundColor: 'rgba(0,0,0,0.2)', alignItems: 'center', justifyContent: 'center', marginBottom: 16 },
  headerBody: {},
  headerBanco: { color: 'rgba(255,255,255,0.8)', fontSize: 13, fontWeight: '600', marginBottom: 4 },
  headerComercio: { color: '#fff', fontSize: 24, fontWeight: '800', marginBottom: 12 },
  pctBig: { flexDirection: 'row', alignItems: 'baseline', gap: 8 },
  pctBigText: { color: '#fff', fontSize: 42, fontWeight: '900' },
  pctBigSub: { color: 'rgba(255,255,255,0.85)', fontSize: 16, fontWeight: '600' },

  body: { flex: 1, padding: 16 },

  estadoBadge: { flexDirection: 'row', alignItems: 'center', gap: 6, paddingHorizontal: 14, paddingVertical: 8, borderRadius: theme.radius.full, alignSelf: 'flex-start', marginBottom: 16 },
  estadoVerde: { backgroundColor: '#0A2A1A' },
  estadoRojo: { backgroundColor: '#2A0A0A' },
  estadoText: { fontSize: 13, fontWeight: '600' },

  card: { backgroundColor: theme.colors.bgCard, borderRadius: theme.radius.lg, padding: 16, marginBottom: 12, borderWidth: 1, borderColor: theme.colors.border },
  cardTitle: { color: theme.colors.textSecondary, fontSize: 12, fontWeight: '700', textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 14 },
  cardText: { color: theme.colors.text, fontSize: 14, lineHeight: 22 },

  infoRow: { flexDirection: 'row', alignItems: 'flex-start', gap: 12 },
  infoIcon: { width: 32, height: 32, borderRadius: 8, backgroundColor: theme.colors.bgCardAlt, alignItems: 'center', justifyContent: 'center' },
  infoLabel: { color: theme.colors.textSecondary, fontSize: 11, marginBottom: 2 },
  infoValue: { color: theme.colors.text, fontSize: 14, fontWeight: '600' },
  divider: { height: 1, backgroundColor: theme.colors.border, marginVertical: 12 },

  btnBases: { backgroundColor: theme.colors.bgCard, borderRadius: theme.radius.lg, borderWidth: 1, borderColor: theme.colors.primary + '55', flexDirection: 'row', alignItems: 'center', padding: 16, gap: 10, marginBottom: 12 },
  btnBasesText: { flex: 1, color: theme.colors.primary, fontSize: 14, fontWeight: '600' },

  featuredBadge: { flexDirection: 'row', alignItems: 'center', gap: 6, justifyContent: 'center', padding: 10 },
  featuredText: { color: '#F59E0B', fontSize: 13, fontWeight: '600' },
});
